RAGOPS_ENV=local
RAGOPS_LLM_PROVIDER=deterministic
RAGOPS_DEFAULT_TENANT=tenant-alpha
RAGOPS_PROMPT_VERSION=ragops-prompt-v1
RAGOPS_MODEL=deterministic-ragops-v1

# Optional OpenAI provider. Leave unset for local deterministic mode.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Azure OpenAI provider. Leave unset for local deterministic mode.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=


# Dashboard-to-API endpoint used only by the Streamlit process.
RAGOPS_API_URL=http://localhost:8000

# Optional German demo-video voice. The API key is read only from this environment variable.
VIDEO_LANGUAGE=de
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_API_PORT=8765
VIDEO_DASHBOARD_PORT=8766
VIDEO_CHROME_DEBUG_PORT=8767
VIDEO_BURN_SUBTITLES=false
VIDEO_TRANSITION_SECONDS=0.35
TTS_PROVIDER=openai
TTS_MODEL=
TTS_VOICE=
TTS_SPEECH_INSTRUCTIONS=
TTS_AUDIO_FORMAT=wav
TTS_SPEAKING_SPEED=1.0
TTS_MAX_API_CALLS_PER_BUILD=20
MAX_TTS_RETRIES=2
TTS_MIN_AUDIO_BYTES=256

# Bounded master-loop defaults.
MASTER_MAX_RETRIES_PER_STATE=3
MASTER_MAX_GLOBAL_ITERATIONS=30
MASTER_COMMAND_TIMEOUT_SECONDS=900
