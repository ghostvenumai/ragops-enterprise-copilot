RAGOPS_ENV=local
RAGOPS_LLM_PROVIDER=deterministic
RAGOPS_DEFAULT_TENANT=tenant-alpha
RAGOPS_PROMPT_VERSION=ragops-prompt-v1
RAGOPS_MODEL=deterministic-ragops-v1

# Identity boundary. Development is explicit and local-only; production requires OIDC.
RAGOPS_IDENTITY_PROVIDER=development
RAGOPS_DEV_USER_ID=demo-user
RAGOPS_DEV_TENANT_ID=tenant-alpha
RAGOPS_DEV_ROLES=sales

# Production OIDC placeholders; inject the public key via a secret manager.
RAGOPS_OIDC_ISSUER=
RAGOPS_OIDC_AUDIENCE=
RAGOPS_OIDC_PUBLIC_KEY=
RAGOPS_OIDC_ALGORITHMS=RS256
RAGOPS_OIDC_TENANT_CLAIM=tenant_id
RAGOPS_OIDC_ROLES_CLAIM=roles

# Vector boundary. Deterministic is explicit local/test behavior; production requires Qdrant.
RAGOPS_VECTOR_PROVIDER=deterministic
RAGOPS_QDRANT_URL=
RAGOPS_QDRANT_COLLECTION=ragops_vectors
RAGOPS_QDRANT_API_KEY=
RAGOPS_VECTOR_SCHEMA_VERSION=v1
RAGOPS_EMBEDDING_PROVIDER=deterministic
RAGOPS_EMBEDDING_MODEL=deterministic-hash-v1
RAGOPS_EMBEDDING_DIMENSION=64

# Optional OpenAI provider. Leave unset for local deterministic mode.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Azure OpenAI provider. Leave unset for local deterministic mode.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=


# Dashboard-to-API endpoint used only by the Streamlit process.
RAGOPS_API_URL=http://localhost:8000

# Optional German demo-video voice. The API key is read only from this environment variable.
VIDEO_LANGUAGE=de
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_API_PORT=8765
VIDEO_DASHBOARD_PORT=8766
VIDEO_CHROME_DEBUG_PORT=8767
VIDEO_BURN_SUBTITLES=false
VIDEO_TRANSITION_SECONDS=0.35
TTS_PROVIDER=openai
TTS_MODEL=
TTS_VOICE=
TTS_SPEECH_INSTRUCTIONS=
TTS_AUDIO_FORMAT=wav
TTS_SPEAKING_SPEED=1.0
TTS_MAX_API_CALLS_PER_BUILD=20
MAX_TTS_RETRIES=2
TTS_MIN_AUDIO_BYTES=256

# Bounded master-loop defaults.
MASTER_MAX_RETRIES_PER_STATE=3
MASTER_MAX_GLOBAL_ITERATIONS=30
MASTER_COMMAND_TIMEOUT_SECONDS=900
