:443 {
  encode gzip
  # TLS terminates here; api and dashboard are reached over the internal appnet only.
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    Cache-Control "no-store"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
  }
  handle /api/* {
    reverse_proxy api:8000
  }
  handle {
    reverse_proxy dashboard:8501 {
      # Streamlit omits the Secure attribute on its auth cookies; add it at the TLS edge.
      header_down Set-Cookie "^(.*)$" "$1; Secure"
    }
  }
}
