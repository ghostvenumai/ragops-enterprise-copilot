# Secret-free template; fill manually outside the repository on an authorized host.
RAGOPS_ENV=production
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_TEST_USER_PASSWORD=
RAGOPS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres:5432/ragops
RAGOPS_TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres:5432/ragops_test_integration
RAGOPS_REDIS_URL=redis://redis:6379/0
RAGOPS_QDRANT_URL=http://qdrant:6333
RAGOPS_QDRANT_COLLECTION=ragops_vectors
RAGOPS_VECTOR_PROVIDER=qdrant
RAGOPS_IDENTITY_PROVIDER=oidc
RAGOPS_OIDC_ISSUER=https://OIDC-ISSUER.example
RAGOPS_OIDC_AUDIENCE=ragops
RAGOPS_OIDC_PUBLIC_KEY=
RAGOPS_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
RAGOPS_ALLOW_PAID_INTEGRATION_TESTS=0
